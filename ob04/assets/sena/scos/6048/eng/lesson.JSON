imuli_ids": []}, {"template_override": 1, "type": "DWS", "questions": [{"responses": [{"correct": 1, "_data": [{"content": "", "type": "text"}], "selected": 0, "id": 0}], "_data": [{"type": "question", "contents": [{"content": "engenn7le10ob04re7pdf01.pdf", "type": "pdf"}]}], "id": 0}], "_data": [{"type": "instructions", "contents": [{"content": " Write a dialogue about the danger of new technologies.", "type": "text"}]}, {"type": "group", "contents": [{"content": "Take Away", "type": "group_name"}]}, {"content": {"allowed_attempts": 2, "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}], "correct_feedback": "Correct!", "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}]}, "type": "feedback"}, {"type": "learning_skills", "contents": [{"content": "Reading", "type": "skill"}, {"content": "Writing", "type": "skill"}, {"content": "Speaking", "type": "skill"}]}, {"type": "post_instructions", "contents": [{"content": "Instructions: Complete the following steps. Fill in the Self-Assessment.", "type": "text"}]}], "id": 11, "stimuli_ids": []}], "type": "scholar", "stimuli": [{"template_override": 1, "type": "welcome", "_data": [], "contents": [{}], "id": 0}, {"template_override": 1, "type": "audio", "id": 1, "title": "", "contents": [{"type": "slideshow", "value": {"audiosrc": "engenn7le10ob04re2aud01", "coverimg": "engenn7le10ob04re2img05.jpg", "images": [{"image": "engenn7le10ob04re2img05.jpg", "text": "", "time": "0", "id": 0}, {"image": "engenn7le10ob04re2img05.jpg", "text": "<span class=\"strong\">Sally</span>:        I just had the most amazing interview with a technology advocate. He showed me how virtual reality will take over the world. People from all over the world will be able to connect and experience the same thing at the same time. I can't wait until it gets published in the next issue!<br/>\n<span class=\"strong\">Amanda</span>:    Hmm ... I don't think I'm looking forward to this scenario.<br/>\n<span class=\"strong\">Sally</span>:        Why are you shrugging? You don't think that computers can help people connect with each other?<br/>", "time": "100", "id": 1}, {"image": "engenn7le10ob04re2img01.jpg", "text": "<span class=\"strong\">Amanda</span>:    I think we're becoming too dependent on electronic devices. I thought that social media would have helped me keep in touch with my contacts, but I feel like my social circle has shrunk because of it. <br/>\n<span class=\"strong\">Sally</span>:        Why do you say that? Do you mean you don't enjoy the time you spend online?", "time": "26600", "id": 2}, {"image": "engenn7le10ob04re2img02.jpg", "text": "<span class=\"strong\">Amanda</span>:    It seems that every time I visit a forum, everyone shouts at each other for no reason. Sometimes when I read online comments all I hear is people shrieking at me.<br/>\n<span class=\"strong\">Sally</span>:        I know ... I try to stay away from that kind of website.<br/>\n<span class=\"strong\">Amanda</span>:    Yeah. It makes me want to put these useless debates through a shredder.    <br/>\n<span class=\"strong\">Sally</span>:        Oh Amanda, you're such a luddite. Don't you think you should try to adapt instead?", "time": "42000", "id": 3}]}}], "_data": []}], "_data": [{"type": "lab_options", "contents": [{"content": true, "type": "has_nav"}, {"content": true, "type": "has_exercise_controls"}]}], "id": 0}], "type": "sena"}